        "build_event_stream.proto": "7287f1259508390482d4099c2cbe36400fdd0ca8b6ad030428a35e0a587c38f1",
        "command_line.proto": "a6fb6591aa50794431787169bc4fae16105ef5c401e7c30ecf0f775e0ab25c2c",
        "failure_details.proto": "d790ff40dfaf3fdd2cf21c228e320b091dec2f25fbc7927463473c5e887cf988",
        "invocation_policy.proto": "d17bdf99a9df0169b6d011e457cf1a1783ce94bab30b61e9681384493a3b3e53",
        "option_filters.proto": "2059522a8e5a28d2e05561e42d76238e774229543fa64384c0762267673a4a23",
